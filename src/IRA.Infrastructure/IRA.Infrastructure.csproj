<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure Layer.
    Concrete implementations of the Application ports using Azure services and
    Semantic Kernel, each paired with a deterministic offline fallback so the
    solution runs (and tests pass) before Azure keys are provided.
  -->
  <PropertyGroup>
    <RootNamespace>IRA.Infrastructure</RootNamespace>
    <AssemblyName>IRA.Infrastructure</AssemblyName>
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010;SKEXP0020;SKEXP0050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure OpenAI (chat + embeddings) -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.2.0-beta.5" />
    <!-- Azure AI Search (vector database) -->
    <PackageReference Include="Azure.Search.Documents" Version="11.6.0" />
    <!-- Azure Document Intelligence (resume extraction) -->
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <!-- Azure Blob Storage (resume & JD storage) -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <!-- Azure Key Vault (secret management) -->
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
    <!-- Semantic Kernel (AI orchestration & agent framework) -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.61.0" />
    <!-- Application Insights (monitoring & observability) -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <!-- Resilience / retry policies -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IRA.Application\IRA.Application.csproj" />
    <ProjectReference Include="..\IRA.Domain\IRA.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IRA.UnitTests" />
  </ItemGroup>

</Project>
