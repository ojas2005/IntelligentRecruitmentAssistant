@model IRA.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="card-title mb-3">Log in</h4>
                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autofocus />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Log in</button>
                </form>
                <hr />
                <p class="small text-muted mb-1">New candidate? <a asp-controller="Account" asp-action="Register">Create an account</a>.</p>
            </div>
        </div>

        <div class="card mt-3 border-0 bg-light">
            <div class="card-body">
                <h6 class="text-muted">Demo accounts <span class="text-muted">(password <code>Passw0rd!</code>)</span></h6>
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td><code>recruiter</code></td><td class="text-muted">Recruiter portal</td></tr>
                        <tr><td><code>manager</code></td><td class="text-muted">Hiring Manager</td></tr>
                        <tr><td><code>admin</code></td><td class="text-muted">Administrator (+ Analytics)</td></tr>
                        <tr><td><code>candidate</code></td><td class="text-muted">Candidate portal</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
