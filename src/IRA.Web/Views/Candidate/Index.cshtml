@model IReadOnlyList<CandidateDto>
@{
    ViewData["Title"] = "Candidates";
}

<div class="page-head d-flex justify-content-between align-items-end flex-wrap gap-3">
    <div>
        <h1>Candidates</h1>
    </div>
    <a class="btn btn-outline-dark btn-sm" asp-controller="Resume" asp-action="Index">Upload resumes</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No candidates yet. <a asp-controller="Resume" asp-action="Index">Upload resumes</a> to get started.</div>
}
else
{
    <div class="table-card reveal">
        <table class="table align-middle mb-0">
            <thead>
            <tr><th>Name</th><th>Location</th><th>Experience</th><th>Skills</th></tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="fw-semibold">@c.FullName</td>
                    <td class="text-muted">@(c.Location ?? "—")</td>
                    <td>@c.TotalYearsExperience.ToString("0.#") yrs</td>
                    <td>
                        @foreach (var s in c.Skills.Take(10))
                        {
                            <span class="chip">@s</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
