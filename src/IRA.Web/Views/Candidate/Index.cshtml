@model IReadOnlyList<CandidateDto>
@{
    ViewData["Title"] = "Candidates";
}

<h2 class="mb-4">Candidate Dashboard</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No candidates yet. <a asp-controller="Resume" asp-action="Index">Upload resumes</a> to get started.</div>
}
else
{
    <table class="table bg-white align-middle">
        <thead>
        <tr><th>Name</th><th>Location</th><th>Experience</th><th>Skills</th></tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td class="fw-semibold">@c.FullName</td>
                <td>@(c.Location ?? "—")</td>
                <td>@c.TotalYearsExperience.ToString("0.#") yrs</td>
                <td>
                    @foreach (var s in c.Skills.Take(10))
                    {
                        <span class="badge bg-light text-dark border me-1">@s</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
