@model IReadOnlyList<AuditEntryDto>
@{
    ViewData["Title"] = "Recruitment Analytics";
}

<div class="page-head">
    <h1>Analytics &amp; audit trail</h1>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No audit activity recorded yet.</div>
}
else
{
    <div class="table-card reveal">
        <table class="table table-striped align-middle mb-0">
            <thead>
            <tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Entity</th><th>Details</th></tr>
            </thead>
            <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td class="text-muted small">@e.TimestampUtc.ToString("u")</td>
                    <td class="fw-semibold">@e.Actor</td>
                    <td><span class="badge bg-secondary">@e.Action</span></td>
                    <td class="text-muted">@e.EntityType</td>
                    <td class="small">@e.Details</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
