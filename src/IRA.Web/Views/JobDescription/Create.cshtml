@{
    ViewData["Title"] = "New Job Description";
}

<h2 class="mb-4">Create Job Description</h2>

<div class="card p-4">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Title</label>
                <input name="title" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Department</label>
                <input name="department" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Minimum Years of Experience</label>
                <input name="minYearsExperience" type="number" step="0.5" value="0" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Required Skills (comma-separated)</label>
                <input name="requiredSkills" class="form-control" placeholder="C#, ASP.NET Core, Azure" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Preferred Skills (comma-separated)</label>
                <input name="preferredSkills" class="form-control" placeholder="Semantic Kernel, Docker" />
            </div>
            <div class="col-12">
                <label class="form-label">Job Description Text</label>
                <textarea name="rawText" rows="6" class="form-control" required></textarea>
            </div>
        </div>
        <button type="submit" class="btn btn-primary mt-3">Create</button>
        <a class="btn btn-link mt-3" asp-action="Index">Cancel</a>
    </form>
</div>
