@model IReadOnlyList<JobDescriptionDto>
@{
    ViewData["Title"] = "Job Descriptions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Job Description Management</h2>
    <a class="btn btn-primary" asp-action="Create">+ New Job Description</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No job descriptions yet. Create one to evaluate candidates against it.</div>
}
else
{
    <div class="row g-3">
        @foreach (var j in Model)
        {
            <div class="col-md-6">
                <div class="card p-3 h-100">
                    <h5>@j.Title</h5>
                    <div class="text-muted mb-2">@(j.Department ?? "General") · min @j.MinYearsExperience.ToString("0.#") yrs</div>
                    <div>
                        <strong>Required:</strong>
                        @foreach (var s in j.RequiredSkills)
                        {
                            <span class="badge bg-primary me-1">@s</span>
                        }
                    </div>
                    <div class="mt-1">
                        <strong>Preferred:</strong>
                        @foreach (var s in j.PreferredSkills)
                        {
                            <span class="badge bg-secondary me-1">@s</span>
                        }
                    </div>
                    <a class="btn btn-sm btn-outline-primary mt-3" asp-controller="Ranking" asp-action="Index">Evaluate candidates →</a>
                </div>
            </div>
        }
    </div>
}
