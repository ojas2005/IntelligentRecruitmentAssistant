@model IReadOnlyList<JobDescriptionDto>
@{
    ViewData["Title"] = "Job Descriptions";
}

<div class="page-head d-flex justify-content-between align-items-end flex-wrap gap-3">
    <div>
        <span class="section-label">Recruiter portal</span>
        <h1 class="mt-2">Job descriptions</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ New job description</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No job descriptions yet. Create one to evaluate candidates against it.</div>
}
else
{
    <div class="row g-4">
        @foreach (var j in Model)
        {
            <div class="col-md-6">
                <div class="card tilt lift p-4 h-100 reveal" data-tilt>
                    <div class="pop">
                        <h5 class="mb-1">@j.Title</h5>
                        <p class="text-muted small mb-3">@(j.Department ?? "General") · min @j.MinYearsExperience.ToString("0.#") yrs</p>
                        <div><span class="section-label">Required</span></div>
                        <div class="mt-2 mb-2">
                            @foreach (var s in j.RequiredSkills)
                            {
                                <span class="badge bg-primary me-1 mb-1">@s</span>
                            }
                        </div>
                        <div><span class="section-label">Preferred</span></div>
                        <div class="mt-2">
                            @foreach (var s in j.PreferredSkills)
                            {
                                <span class="badge bg-secondary me-1 mb-1">@s</span>
                            }
                        </div>
                        <a class="btn btn-outline-dark btn-sm mt-3" asp-controller="Ranking" asp-action="Index">Evaluate candidates →</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
