@model IReadOnlyList<IRA.Application.DTOs.JobDescriptionDto>
@{
    ViewData["Title"] = "Open Jobs";
}

<div class="page-head">
    <span class="section-label">Candidate portal</span>
    <h1 class="mt-2">Open roles</h1>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">There are no open roles right now. Check back soon.</div>
}
else
{
    <div class="row g-4">
        @foreach (var job in Model)
        {
            <div class="col-md-6">
                <div class="card tilt lift p-4 h-100 reveal" data-tilt>
                    <div class="pop">
                        <h5 class="mb-1">@job.Title</h5>
                        @if (!string.IsNullOrWhiteSpace(job.Department))
                        {
                            <p class="text-muted small mb-2">@job.Department</p>
                        }
                        <span class="chip mb-3">@job.MinYearsExperience.ToString("0.#")+ yrs</span>

                        @if (job.RequiredSkills.Count > 0)
                        {
                            <div class="mt-2"><span class="section-label">Required</span></div>
                            <div class="mt-2">
                                @foreach (var skill in job.RequiredSkills)
                                {
                                    <span class="badge bg-primary me-1 mb-1">@skill</span>
                                }
                            </div>
                        }
                        @if (job.PreferredSkills.Count > 0)
                        {
                            <div class="mt-3"><span class="section-label">Preferred</span></div>
                            <div class="mt-2">
                                @foreach (var skill in job.PreferredSkills)
                                {
                                    <span class="badge bg-secondary me-1 mb-1">@skill</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
