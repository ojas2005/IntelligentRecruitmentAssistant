@model IRA.Application.DTOs.CandidateDto
@{
    ViewData["Title"] = "My Profile";
}

<div class="page-head">
    <h1>My profile</h1>
</div>

@if (Model is null)
{
    <div class="glass p-5 text-center reveal">
        <div style="font-size:2.4rem">📄</div>
        <p class="text-muted mt-3">You haven't uploaded a resume yet.</p>
        <a asp-controller="Resume" asp-action="Index" class="btn btn-primary btn-lg mt-2">Upload your resume</a>
    </div>
}
else
{
    <div class="card lift p-4 p-md-5 mb-4 reveal">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h2 style="font-size:2rem">@Model.FullName</h2>
                <p class="text-muted mb-0">
                    @if (!string.IsNullOrWhiteSpace(Model.Email)) { <span>@Model.Email</span> }
                    @if (!string.IsNullOrWhiteSpace(Model.Location)) { <span> · @Model.Location</span> }
                </p>
            </div>
            <span class="chip mb-0">@Model.TotalYearsExperience.ToString("0.#") yrs experience</span>
        </div>

        <hr class="divider" />
        <span class="section-label">Skills</span>
        <div class="mt-3">
            @if (Model.Skills.Count == 0)
            {
                <p class="text-muted small mb-0">No skills were extracted.</p>
            }
            else
            {
                foreach (var skill in Model.Skills)
                {
                    <span class="chip">@skill</span>
                }
            }
        </div>
    </div>
    <a asp-controller="Resume" asp-action="Index" class="btn btn-outline-dark btn-sm">Upload a new resume</a>
    <a asp-controller="Portal" asp-action="Jobs" class="btn btn-outline-dark btn-sm">Browse open jobs</a>
}
