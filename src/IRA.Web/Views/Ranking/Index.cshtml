@model RankingViewModel
@{
    ViewData["Title"] = "Ranking Dashboard";

    string ScoreColor(double s) => s >= 85 ? "#1f9d63" : s >= 70 ? "#2f6df6" : s >= 50 ? "#e08a1e" : "#d5443a";
}

<div class="page-head">
    <h1>Candidate ranking</h1>
</div>

<div class="glass p-4 p-md-5 mb-4 reveal">
    <form asp-action="Evaluate" method="post" class="row g-3 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-md-6">
            <label class="form-label">Job description</label>
            <select name="jobId" class="form-select" required>
                <option value="">— Select a role —</option>
                @foreach (var j in Model.Jobs)
                {
                    <option value="@j.Id" selected="@(Model.SelectedJobId == j.Id)">@j.Title</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Interview shortlist size</label>
            <input name="shortlistSize" type="number" value="5" min="0" class="form-control" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100 btn-lg">Run AI evaluation</button>
        </div>
    </form>
    <p class="text-muted small mt-3 mb-0">Runs the full flow: Extract → Analyze → Match → Generate Questions → Rank.</p>
</div>

@if (Model.Result is { } result)
{
    if (result.UsedAiFallback)
    {
        <div class="alert alert-warning">
            Azure OpenAI is not configured — results were produced by the deterministic fallback engine.
            Add your Azure keys in <code>appsettings.json</code> to enable generative AI.
        </div>
    }

    <div class="card lift p-4 p-md-5 mb-4 reveal">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 style="font-size:1.8rem">Shortlist · @result.Ranking.JobTitle</h2>
            @if (result.Ranking.ReviewerApproved)
            {
                <span class="badge bg-success">✓ Reviewer approved</span>
            }
            else
            {
                <span class="badge bg-warning">⚠ Reviewer flagged</span>
            }
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                <tr><th>#</th><th>Candidate</th><th>Score</th><th>Recommendation</th><th>Justification</th></tr>
                </thead>
                <tbody>
                @foreach (var c in result.Ranking.Candidates)
                {
                    <tr>
                        <td class="fw-bold">@c.Rank</td>
                        <td class="fw-semibold">@c.CandidateName</td>
                        <td><span class="score-pill" style="background:@ScoreColor(c.Score)">@c.Score.ToString("0.#")</span></td>
                        <td>@c.Recommendation</td>
                        <td><small class="text-muted">@c.Justification</small></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="page-head"><h2 style="font-size:1.6rem">Evaluation detail</h2><p class="text-muted small mb-0">Skill gaps &amp; RAG citations</p></div>
    <div class="row g-4 mb-4">
        @foreach (var e in result.Evaluations.OrderByDescending(x => x.FitScore))
        {
            <div class="col-md-6">
                <div class="card lift p-4 h-100 reveal">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="mb-1">@e.CandidateName</h5>
                        <span class="score-pill" style="background:@ScoreColor(e.FitScore)">@e.FitScore.ToString("0.#")</span>
                    </div>
                    <p class="text-muted small mt-2 mb-2">@e.Summary</p>
                    <p class="small mb-3">@e.Reasoning</p>
                    <div class="mb-2"><span class="section-label">Matched</span></div>
                    <div class="mb-3">
                        @foreach (var s in e.MatchedSkills)
                        {
                            <span class="badge bg-success me-1 mb-1">@s</span>
                        }
                    </div>
                    <div class="mb-2"><span class="section-label">Gaps</span></div>
                    <div>
                        @foreach (var g in e.SkillGaps)
                        {
                            <span class="badge @(g.Required ? "bg-danger" : "bg-secondary") me-1 mb-1">@g.SkillName</span>
                        }
                    </div>
                    @if (e.Citations.Count > 0)
                    {
                        <hr class="divider" style="margin:1rem 0" />
                        <span class="section-label">Citations (RAG)</span>
                        <ul class="small text-muted mt-2 mb-0" style="padding-left:1.1rem">
                            @foreach (var cit in e.Citations)
                            {
                                <li><span class="fw-semibold">@cit.SourceName</span> · @cit.Score.ToString("0.00") — @cit.Snippet</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </div>

    @if (result.InterviewKits.Count > 0)
    {
        <div class="page-head"><h2 style="font-size:1.6rem">Generated interview questions</h2></div>
        @foreach (var kit in result.InterviewKits)
        {
            var candidate = result.Ranking.Candidates.FirstOrDefault(c => c.CandidateId == kit.CandidateId);
            <div class="card lift p-4 mb-3 reveal">
                <h6 class="mb-3">@(candidate?.CandidateName ?? kit.CandidateId.ToString())</h6>
                <ul class="mb-0" style="padding-left:1.1rem">
                    @foreach (var q in kit.Questions)
                    {
                        <li class="mb-2">
                            <span class="badge bg-info me-1">@q.Type</span>
                            <span class="badge bg-light me-1">@q.Difficulty</span>
                            @q.Text
                            @if (!string.IsNullOrWhiteSpace(q.EvaluationCriteria))
                            {
                                <div class="text-muted small mt-1">Evaluation: @q.EvaluationCriteria</div>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    }
}
