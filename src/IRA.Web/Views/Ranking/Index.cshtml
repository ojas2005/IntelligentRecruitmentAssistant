@model RankingViewModel
@{
    ViewData["Title"] = "Ranking Dashboard";

    string ScoreColor(double s) => s >= 85 ? "#198754" : s >= 70 ? "#0d6efd" : s >= 50 ? "#fd7e14" : "#dc3545";
}

<h2 class="mb-4">Candidate Ranking Dashboard</h2>

<div class="card p-4 mb-4">
    <form asp-action="Evaluate" method="post" class="row g-3 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-md-6">
            <label class="form-label">Job Description</label>
            <select name="jobId" class="form-select" required>
                <option value="">— Select a role —</option>
                @foreach (var j in Model.Jobs)
                {
                    <option value="@j.Id" selected="@(Model.SelectedJobId == j.Id)">@j.Title</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Interview shortlist size</label>
            <input name="shortlistSize" type="number" value="5" min="0" class="form-control" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Run AI Evaluation</button>
        </div>
    </form>
    <small class="text-muted mt-2">
        Runs the full flow: Extract → Analyze → Match → Generate Questions → Rank.
    </small>
</div>

@if (Model.Result is { } result)
{
    if (result.UsedAiFallback)
    {
        <div class="alert alert-warning">
            Azure OpenAI is not configured — results were produced by the deterministic fallback engine.
            Add your Azure keys in <code>appsettings.json</code> to enable generative AI.
        </div>
    }

    <div class="card p-3 mb-4">
        <h4 class="mb-3">Shortlist for “@result.Ranking.JobTitle”
            @if (result.Ranking.ReviewerApproved)
            {
                <span class="badge bg-success">Reviewer Approved</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Reviewer Flagged</span>
            }
        </h4>
        <table class="table align-middle">
            <thead>
            <tr><th>#</th><th>Candidate</th><th>Score</th><th>Recommendation</th><th>Justification</th></tr>
            </thead>
            <tbody>
            @foreach (var c in result.Ranking.Candidates)
            {
                <tr>
                    <td class="fw-bold">@c.Rank</td>
                    <td>@c.CandidateName</td>
                    <td><span class="score-pill" style="background:@ScoreColor(c.Score)">@c.Score.ToString("0.#")</span></td>
                    <td>@c.Recommendation</td>
                    <td><small>@c.Justification</small></td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <h4 class="mb-3">Evaluation Detail (Skill Gaps &amp; Citations)</h4>
    <div class="row g-3 mb-4">
        @foreach (var e in result.Evaluations.OrderByDescending(x => x.FitScore))
        {
            <div class="col-md-6">
                <div class="card p-3 h-100">
                    <div class="d-flex justify-content-between">
                        <h5>@e.CandidateName</h5>
                        <span class="score-pill" style="background:@ScoreColor(e.FitScore)">@e.FitScore.ToString("0.#")</span>
                    </div>
                    <p class="text-muted">@e.Summary</p>
                    <p><small>@e.Reasoning</small></p>
                    <div>
                        <strong>Matched:</strong>
                        @foreach (var s in e.MatchedSkills)
                        {
                            <span class="badge bg-success me-1">@s</span>
                        }
                    </div>
                    <div class="mt-1">
                        <strong>Gaps:</strong>
                        @foreach (var g in e.SkillGaps)
                        {
                            <span class="badge @(g.Required ? "bg-danger" : "bg-secondary") me-1">@g.SkillName</span>
                        }
                    </div>
                    @if (e.Citations.Count > 0)
                    {
                        <div class="mt-2">
                            <strong>Citations (RAG):</strong>
                            <ul class="small mb-0">
                                @foreach (var cit in e.Citations)
                                {
                                    <li>[@cit.SourceName · @cit.Score.ToString("0.00")] @cit.Snippet</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (result.InterviewKits.Count > 0)
    {
        <h4 class="mb-3">Generated Interview Questions</h4>
        @foreach (var kit in result.InterviewKits)
        {
            var candidate = result.Ranking.Candidates.FirstOrDefault(c => c.CandidateId == kit.CandidateId);
            <div class="card p-3 mb-3">
                <h6>@(candidate?.CandidateName ?? kit.CandidateId.ToString())</h6>
                <ul class="mb-0">
                    @foreach (var q in kit.Questions)
                    {
                        <li>
                            <span class="badge bg-info text-dark">@q.Type</span>
                            <span class="badge bg-light text-dark border">@q.Difficulty</span>
                            @q.Text
                            @if (!string.IsNullOrWhiteSpace(q.EvaluationCriteria))
                            {
                                <div class="text-muted small">Evaluation: @q.EvaluationCriteria</div>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    }
}
