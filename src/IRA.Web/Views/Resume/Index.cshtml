@{
    ViewData["Title"] = "Upload Resume";
    var isCandidate = ViewBag.IsCandidate as bool? ?? false;
}

<h2 class="mb-4">@(isCandidate ? "Upload My Resume" : "Resume Upload Portal")</h2>

<div class="card p-4">
    <form asp-action="Upload" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            @if (isCandidate)
            {
                <label class="form-label">Select your resume file</label>
                <input type="file" name="files" class="form-control" accept=".txt,.pdf,.docx,.md,.json" required />
                <div class="form-text">
                    Your resume is stored, text is extracted (Azure Document Intelligence), parsed by the
                    Resume Parser Agent, embedded and indexed — then linked to your profile.
                </div>
            }
            else
            {
                <label class="form-label">Select resume file(s) — bulk upload supported</label>
                <input type="file" name="files" class="form-control" multiple accept=".txt,.pdf,.docx,.md,.json" required />
                <div class="form-text">
                    Files are stored, text is extracted (Azure Document Intelligence), parsed by the
                    Resume Parser Agent, embedded and indexed for RAG.
                </div>
            }
        </div>
        <button type="submit" class="btn btn-primary">Upload &amp; Process</button>
    </form>
</div>
