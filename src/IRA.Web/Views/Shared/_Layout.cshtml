@using IRA.Web.Auth
@{
    var isRecruiter = User.IsInRole(WebRoles.Recruiter) || User.IsInRole(WebRoles.HiringManager) || User.IsInRole(WebRoles.Administrator);
    var isCandidate = User.IsInRole(WebRoles.Candidate) && !isRecruiter;
    var isAdmin = User.IsInRole(WebRoles.Administrator);
    var authed = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Intelligent Recruitment Assistant</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://db.onlinewebfonts.com/c/9d4d074c9335825a23cce178ee03b498?family=P22+Mackinac+W01+Book" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-aurora" aria-hidden="true"><span class="o1"></span><span class="o2"></span><span class="o3"></span></div>

<nav class="app-nav">
    <div class="inner">
        <a class="brand" asp-controller="@(authed ? (isCandidate ? "Portal" : "Home") : "Account")" asp-action="Index">
            <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
                <rect width="32" height="32" rx="9"></rect>
                <path d="M12 10.2 L21 16 L12 21.8 Z" fill="#fff"></path>
                <circle cx="11.6" cy="16" r="1.5" fill="#fff"></circle>
            </svg>
            <b>Recruitment&nbsp;Assistant</b>
        </a>

        @if (authed)
        {
            <div class="nav-links">
                @if (isRecruiter)
                {
                    <a asp-controller="Home" asp-action="Index">Dashboard</a>
                    <a asp-controller="Resume" asp-action="Index">Upload</a>
                    <a asp-controller="JobDescription" asp-action="Index">Jobs</a>
                    <a asp-controller="Candidate" asp-action="Index">Candidates</a>
                    <a asp-controller="Ranking" asp-action="Index">Ranking</a>
                    @if (isAdmin)
                    {
                        <a asp-controller="Home" asp-action="Analytics">Analytics</a>
                    }
                }
                else if (isCandidate)
                {
                    <a asp-controller="Portal" asp-action="Index">My Portal</a>
                    <a asp-controller="Portal" asp-action="Profile">My Profile</a>
                    <a asp-controller="Resume" asp-action="Index">Upload Resume</a>
                    <a asp-controller="Portal" asp-action="Jobs">Browse Jobs</a>
                }
            </div>
        }

        <div class="nav-right">
            @if (authed)
            {
                <span class="who">
                    @User.Identity!.Name
                    @if (isRecruiter) { <span class="role-badge rec">Recruiter</span> }
                    else if (isCandidate) { <span class="role-badge cand">Candidate</span> }
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-dark btn-sm">Log out</button>
                </form>
            }
            else
            {
                <a class="nav-links-cta btn btn-outline-dark btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Get started</a>
            }
            <button class="nav-toggle" type="button" aria-label="Menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
        </div>
    </div>
</nav>

<main class="wrap">
    @if (TempData["Message"] is string msg)
    {
        <div class="alert alert-success">@msg</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }
    @RenderBody()
</main>

<footer class="app-footer">
    Intelligent Recruitment Assistant · .NET 9 · Azure OpenAI · Semantic Kernel · Clean Architecture
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
