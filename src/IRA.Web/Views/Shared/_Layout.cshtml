@using IRA.Web.Auth
@{
    var isRecruiter = User.IsInRole(WebRoles.Recruiter) || User.IsInRole(WebRoles.HiringManager) || User.IsInRole(WebRoles.Administrator);
    var isCandidate = User.IsInRole(WebRoles.Candidate) && !isRecruiter;
    var isAdmin = User.IsInRole(WebRoles.Administrator);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Intelligent Recruitment Assistant</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🧭 Recruitment Assistant</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                @if (isRecruiter)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Resume" asp-action="Index">Upload Resumes</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="JobDescription" asp-action="Index">Job Descriptions</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Candidate" asp-action="Index">Candidates</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Ranking" asp-action="Index">Ranking</a></li>
                    @if (isAdmin)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Analytics">Analytics</a></li>
                    }
                }
                else if (isCandidate)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Portal" asp-action="Index">My Portal</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Portal" asp-action="Profile">My Profile</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Resume" asp-action="Index">Upload Resume</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Portal" asp-action="Jobs">Browse Jobs</a></li>
                }
            </ul>
            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <span class="navbar-text text-white-50 me-3">
                            @User.Identity!.Name
                            @if (isRecruiter) { <span class="badge bg-light text-primary ms-1">Recruiter</span> }
                            else if (isCandidate) { <span class="badge bg-warning text-dark ms-1">Candidate</span> }
                        </span>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </div>
    </div>
</nav>
<div class="container">
    @if (TempData["Message"] is string msg)
    {
        <div class="alert alert-success">@msg</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }
    @RenderBody()
</div>
<footer class="text-center text-muted py-4 mt-5 border-top">
    <small>Intelligent Recruitment Assistant · .NET 9 · Azure OpenAI · Semantic Kernel · Clean Architecture</small>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
